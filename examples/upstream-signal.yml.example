# Install on Rstone/master. For RstoneTDS use main, '*.TDS.md', and source-signal/tds.
name: Notify RSTONE data publisher
on:
  push:
    branches: [master]
    paths:
      - '产品列表/**/*.md'
      - '产品应用/**/*.md'
      - '产品配方/**/*.md'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: rstone-data-notification
  cancel-in-progress: false
jobs:
  notify:
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-latest
    timeout-minutes: 5
    environment: rstone-data-notify
    steps:
      - name: Checkout public publisher for notification only
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: Mehael-Yeh/RSTONE_Data
          ref: main
          path: publisher-signal
          ssh-key: ${{ secrets.RSTONE_DATA_SIGNAL_KEY }}
          persist-credentials: true
      - name: Push a notification containing no source files
        working-directory: publisher-signal
        env:
          SIGNAL_BRANCH: source-signal/rstone
          SOURCE_SHA: ${{ github.sha }}
          VERIFY_KEY_SCOPE: ${{ github.event_name == 'workflow_dispatch' }}
        shell: bash
        run: |
          git config user.name 'rstone-data-notifier'
          git config user.email 'rstone-data-notifier@users.noreply.github.com'
          main=$(git rev-parse HEAD)
          parents=(-p "$main")
          if git ls-remote --exit-code origin "refs/heads/$SIGNAL_BRANCH" >/dev/null; then
            git fetch --no-tags origin "refs/heads/$SIGNAL_BRANCH"
            parents+=(-p "$(git rev-parse FETCH_HEAD)")
          fi
          tree=$(git rev-parse 'HEAD^{tree}')
          commit=$(printf 'Notify upstream commit %s\n' "$SOURCE_SHA" | git commit-tree "$tree" "${parents[@]}")
          if [ "$VERIFY_KEY_SCOPE" = true ]; then
            if git push origin "$commit:refs/heads/_notification-key-scope-probe"; then
              echo 'ERROR: notification key can write outside signal refs; fix rulesets and remove probe.' >&2
              exit 1
            fi
            echo 'Protected non-signal ref rejected; testing allowed signal ref next.'
          fi
          git push origin "$commit:refs/heads/$SIGNAL_BRANCH"
